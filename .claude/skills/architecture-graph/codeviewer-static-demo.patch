+// Static-demo fork: the real dashboard reads source files from a dev-server
+// endpoint (/file-content.json) that only exists when Vite's own server is
+// running. A `build:demo` bundle has no server at all, so CodeViewer's demo
+// branch below fetches a single pre-baked JSON map (path -> SourceFile)
+// instead, generated at graph-build time and served next to
+// knowledge-graph.json.
+const DEMO_MODE = import.meta.env.VITE_DEMO_MODE === "true";
+let demoSourceFilesPromise: Promise<Record<string, SourceFile>> | null = null;
+function loadDemoSourceFiles(): Promise<Record<string, SourceFile>> {
+  if (!demoSourceFilesPromise) {
+    const base = import.meta.env.BASE_URL || "/";
+    const url = `${base.endsWith("/") ? base : `${base}/`}source-files.json`;
+    demoSourceFilesPromise = fetch(url)
+      .then((res) => (res.ok ? (res.json() as Promise<Record<string, SourceFile>>) : {}))
+      .catch(() => ({}));
+  }
+  return demoSourceFilesPromise;
+}
