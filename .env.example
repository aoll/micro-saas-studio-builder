# Postgres connection string. Local: postgres://postgres:postgres@localhost:5432/msb
DATABASE_URL=

# Better Auth session secret, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build links and check origins. Local: http://localhost:3000
BETTER_AUTH_URL=

# "mock" (default in dev/test/previews) or "live" (real AI Gateway calls)
AI_MODE=

# "true" or "false" — public demo guardrails (seeded products locked, reset page). Local: false
DEMO_MODE=

# AI Gateway API key (or rely on Vercel OIDC in production). Any placeholder works in AI_MODE=mock
AI_GATEWAY_API_KEY=

# Vercel Blob token for uploaded logos. Any placeholder works locally
BLOB_READ_WRITE_TOKEN=

# Shared secret checked by app/api/cron/reset-demo. Any placeholder works locally
CRON_SECRET=

# Optional. Generations allowed per 60 s, per signed-in user and per ip_hash. Default: 10
# GENERATION_RATE_LIMIT_PER_MINUTE=

# Optional. Set to "1" automatically by Vercel; leave unset locally and when self-hosting.
# Enforces the real BotID check only when "1" (lib/security.ts). Never set this yourself.
# VERCEL=
